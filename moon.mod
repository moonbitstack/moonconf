name = "moonbitstack/moonconf"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonconf"

license = "Apache-2.0"

keywords = [
  "config",
  "configuration",
  "ini",
  "properties",
  "java-properties",
  "dotenv",
  "env",
  "hocon",
  "hcl",
  "variable-expansion",
  "interpolation",
  "layering",
  "binding",
  "settings",
  "moonbit",
]

description = "Configuration files, their expansion, their layering and their binding to a typed model."

source = "src"

import {
  "moonbitstack/moonmodel@0.1.4",
  "moonbitstack/moonyaml@0.1.7",
  "moonbitstack/moontoml@0.1.3",
  "moonbitstack/moonjson@0.5.0",
  "moonbitstack/moonknob@0.1.0",
}
