///|
test "python-dotenv: reference above" {
  let text = "B=x\nA=${B}-y\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("B"), Some("x"))
  assert_eq(env.get("A"), Some("x-y"))
  assert_eq(env.length(), 2)
  assert_eq(@dotenv.parse(text).keys(), ["B", "A"])
}

///|
test "python-dotenv: bare dollar name" {
  let text = "B=x\nA=$B-y\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("B"), Some("x"))
  assert_eq(env.get("A"), Some("$B-y"))
  assert_eq(env.length(), 2)
  assert_eq(@dotenv.parse(text).keys(), ["B", "A"])
}

///|
test "python-dotenv: reference below is empty" {
  let text = "A=${B}-y\nB=x\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("-y"))
  assert_eq(env.get("B"), Some("x"))
  assert_eq(env.length(), 2)
  assert_eq(@dotenv.parse(text).keys(), ["A", "B"])
}

///|
test "python-dotenv: reference default" {
  let text = "A=${B:-fallback}\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("fallback"))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["A"])
}

///|
test "python-dotenv: reference default with value" {
  let text = "B=x\nA=${B:-fallback}\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("B"), Some("x"))
  assert_eq(env.get("A"), Some("x"))
  assert_eq(env.length(), 2)
  assert_eq(@dotenv.parse(text).keys(), ["B", "A"])
}

