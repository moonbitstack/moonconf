///|
test "python-dotenv: single quoted reference" {
  let text = "A='${B}'\nB=x\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some(""))
  assert_eq(env.get("B"), Some("x"))
  assert_eq(env.length(), 2)
  assert_eq(@dotenv.parse(text).keys(), ["A", "B"])
}

