///|
test "python-dotenv: dollar alone" {
  let text = "A=cost: $\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("cost: $"))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["A"])
}

///|
test "python-dotenv: dollar before space" {
  let text = "A=cost: $ B\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("cost: $ B"))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["A"])
}

///|
test "python-dotenv: two names on a line" {
  let text = "A=1 B=2\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("1 B=2"))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["A"])
}

///|
test "python-dotenv verbatim 1" {
  let env = @dotenv.load("A=1\n", knobs=@dotenv.verbatim)
  assert_eq(env.get("A"), Some("1"))
}

///|
test "python-dotenv verbatim 2" {
  let env = @dotenv.load("B=x\nA=${B}\n", knobs=@dotenv.verbatim)
  assert_eq(env.get("B"), Some("x"))
  assert_eq(env.get("A"), Some("${B}"))
}

///|
test "python-dotenv verbatim 3" {
  let env = @dotenv.load("A='${B}'\nB=x\n", knobs=@dotenv.verbatim)
  assert_eq(env.get("A"), Some("${B}"))
  assert_eq(env.get("B"), Some("x"))
}
