  assert_eq(env.get("B"), Some("2"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A", "B"])
}

///|
test "reference: no trailing newline" {
  let text = "A=1\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("1"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
