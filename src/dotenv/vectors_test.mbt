// Generated by scripts/vectors/dotenv.py from the reference reader described
// there. Do not edit by hand.

///|
test "reference: bare" {
  let text = "A=1\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("1"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: spaces around" {
  let text = "A = 1\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("1"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: empty value" {
  let text = "A=\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some(""))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: name alone" {
  let text = "A\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some(""))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: comment line" {
  let text = "# A=1\nB=2\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("B"), Some("2"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["B"])
}

///|
test "reference: indented comment" {
  let text = "   # A=1\nB=2\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("B"), Some("2"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["B"])
}

///|
test "reference: export" {
  let text = "export A=1\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("1"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: export tab" {
  let text = "export\tA=1\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("1"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: hash in value" {
  let text = "A=a#b\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("a#b"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: hash after value" {
  let text = "A=a # b\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("a # b"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: comment after quote" {
  let text = "A=\"a\" # note\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("a"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: single quotes" {
  let text = "A='a b'\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("a b"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: single quotes keep dollar" {
  let text = "A='${B}'\nB=x\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("${B}"))
  assert_eq(env.get("B"), Some("x"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A", "B"])
}

///|
test "reference: double quotes" {
  let text = "A=\"a b\"\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("a b"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: double quote escapes" {
  let text = "A=\"a\\nb\\tc\"\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("a\nb\tc"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: double quote escaped dollar" {
  let text = "A=\"\\${B}\"\nB=x\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("${B}"))
  assert_eq(env.get("B"), Some("x"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A", "B"])
}

///|
test "reference: double quote backslash" {
  let text = "A=\"a\\\\b\"\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("a\\b"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: double quote unknown escape" {
  let text = "A=\"a\\qb\"\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("a\\qb"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: multiline double" {
  let text = "A=\"one\ntwo\"\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("one\ntwo"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: multiline single" {
  let text = "A='one\ntwo'\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("one\ntwo"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: reference above" {
  let text = "B=x\nA=${B}-y\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("x-y"))
  assert_eq(env.get("B"), Some("x"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["B", "A"])
}

///|
test "reference: reference bare" {
  let text = "B=x\nA=$B-y\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("x-y"))
  assert_eq(env.get("B"), Some("x"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["B", "A"])
}

///|
test "reference: reference below is empty" {
  let text = "A=${B}-y\nB=x\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("-y"))
  assert_eq(env.get("B"), Some("x"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A", "B"])
}

///|
test "reference: reference default" {
  let text = "A=${B:-fallback}\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("fallback"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

///|
test "reference: self reference" {
  let text = "PATH=/usr/bin\nPATH=${PATH}:/opt/bin\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("PATH"), Some("/usr/bin:/opt/bin"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["PATH", "PATH"])
}

///|
test "reference: later wins" {
  let text = "A=1\nA=2\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("2"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A", "A"])
}

///|
test "reference: blank lines" {
  let text = "\nA=1\n\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("1"))
  assert_eq(@dotenv.parse(text).map(fn(entry) { entry.key }), ["A"])
}

