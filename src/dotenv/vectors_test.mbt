test "python-dotenv: reference with colon" {
  let text = "A=${B:fallback}\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("${B:fallback}"))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["A"])
}

///|
test "python-dotenv: empty reference" {
  let text = "A=${}\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some(""))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["A"])
}

///|
test "python-dotenv: self reference" {
  let text = "P=/usr/bin\nP=${P}:/opt/bin\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("P"), Some("/usr/bin:/opt/bin"))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["P"])
}

///|
test "python-dotenv: later wins" {
  let text = "A=1\nA=2\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("2"))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["A"])
}

