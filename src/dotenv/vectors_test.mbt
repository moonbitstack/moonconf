// Generated by scripts/vectors/envfile.py from `python-dotenv`.
// Do not edit by hand: the answers below are what that reader produced.

///|
test "python-dotenv: bare" {
  let text = "A=1\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("1"))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["A"])
}

///|
test "python-dotenv: spaces around" {
  let text = "A = 1\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("1"))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["A"])
}

///|
test "python-dotenv: spaces before name" {
  let text = "  A=1\n"
  let env = @dotenv.load(text)
  assert_eq(env.get("A"), Some("1"))
  assert_eq(env.length(), 1)
  assert_eq(@dotenv.parse(text).keys(), ["A"])
}

