// Generated by scripts/vectors/expand.py from bash. Do not edit by hand:
// the answers below are what a real shell printed, which is the whole point.

///|
fn vars(pairs : Array[(String, String)]) -> @expand.Vars {
  @expand.Vars::of_map(Map(pairs))
}

///|
test "bash -u: defined" {
  let vars = vars([("A", "value")])
  assert_eq(
    @expand.expand("pre ${A} post", vars, knobs=@expand.strict),
    "pre value post",
  )
}

///|
test "bash: defined" {
  let vars = vars([("A", "value")])
  assert_eq(
    @expand.expand("pre ${A} post", vars, knobs=@expand.lenient),
    "pre value post",
  )
}

///|
test "bash -u: unquoted" {
  let vars = vars([("A", "value")])
  assert_eq(
    @expand.expand("pre $A post", vars, knobs=@expand.strict),
    "pre value post",
  )
}

///|
test "bash: unquoted" {
  let vars = vars([("A", "value")])
  assert_eq(
    @expand.expand("pre $A post", vars, knobs=@expand.lenient),
    "pre value post",
  )
}

///|
test "bash -u: two variables" {
  let vars = vars([("A", "one"), ("B", "two")])
  assert_eq(@expand.expand("${A}-${B}", vars, knobs=@expand.strict), "one-two")
}

///|
test "bash: two variables" {
  let vars = vars([("A", "one"), ("B", "two")])
  assert_eq(@expand.expand("${A}-${B}", vars, knobs=@expand.lenient), "one-two")
}

