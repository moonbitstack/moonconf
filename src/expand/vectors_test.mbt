///|
test "bash -u: question when empty" {
  let vars = vars([("A", "")])
  let refused = Ok(
    @expand.expand("${A:?must be set}", vars, knobs=@expand.strict),
  ) catch {
    error => Err(error)
  }
  match refused {
    Err(_) => ()
    Ok(got) => fail("bash refused this text, expand answered " + got)
  }
}

