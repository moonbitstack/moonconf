    "a = \"one\\ttwo\\nthree \\\"q\\\" \\\\\"\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_text("a"), "one\ttwo\nthree \"q\" \\")
}

