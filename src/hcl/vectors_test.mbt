///|
test "hashicorp hcl: comparison" {
  let body = @hcl.parse(
    "a = 3 > 2\nb = 3 <= 2\nc = 1 == 1\nd = 1 != 2\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_bool("a"), true)
  assert_eq(tree.need_bool("b"), false)
