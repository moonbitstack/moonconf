test "hashicorp hcl: for list with a filter" {
  let body = @hcl.parse(
    "a = [for x in [1, 2, 3] : x if x % 2 == 0]\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need("a").list().length(), 1)
  assert_eq(tree.need_int("a.0"), 2L)
}

///|
test "hashicorp hcl: for with an index" {
  let body = @hcl.parse(
    "a = [for i, x in [\"a\", \"b\"] : \"${i}${x}\"]\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need("a").list().length(), 2)
  assert_eq(tree.need_text("a.0"), "0a")
  assert_eq(tree.need_text("a.1"), "1b")
}

///|
test "hashicorp hcl: for object" {
  let body = @hcl.parse(
    "a = { for k, v in { x = 1, y = 2 } : k => v + 1 }\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_int("a.x"), 2L)
  assert_eq(tree.need_int("a.y"), 3L)
}

///|
test "hashicorp hcl: for object grouping" {
  let body = @hcl.parse(
    "a = { for x in [1, 1, 2] : \"k${x}\" => x... }\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need("a.k1").list().length(), 2)
  assert_eq(tree.need_int("a.k1.0"), 1L)
  assert_eq(tree.need_int("a.k1.1"), 1L)
  assert_eq(tree.need("a.k2").list().length(), 1)
  assert_eq(tree.need_int("a.k2.0"), 2L)
}

