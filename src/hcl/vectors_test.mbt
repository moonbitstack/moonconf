test "hashicorp hcl: for list" {
  let body = @hcl.parse(
    "a = [for x in [1, 2, 3] : x * 2]\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need("a").list().length(), 3)
  assert_eq(tree.need_int("a.0"), 2L)
  assert_eq(tree.need_int("a.1"), 4L)
  assert_eq(tree.need_int("a.2"), 6L)
}

