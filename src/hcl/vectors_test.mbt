test "hashicorp hcl: attribute splat" {
  let body = @hcl.parse(
    "b = var.a.xs[*].n\n",
    context=@hcl.standard().bind(
      "var",
      @moonconf.Node::map(
        [
          (
            "a",
            @moonconf.Node::map(
              [
                (
                  "xs",
                  @moonconf.Node::seq(
                    [
                      @moonconf.Node::map(
                        [("n", @moonconf.Node::num(1L, "vars"))],
                        "vars",
                      ),
                      @moonconf.Node::map(
                        [("n", @moonconf.Node::num(2L, "vars"))],
                        "vars",
                      ),
                    ],
                    "vars",
                  ),
                ),
              ],
              "vars",
            ),
          ),
        ],
        "vars",
      ),
    ),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need("b").list().length(), 2)
  assert_eq(tree.need_int("b.0"), 1L)
  assert_eq(tree.need_int("b.1"), 2L)
}

