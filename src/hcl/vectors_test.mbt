///|
test "hashicorp hcl: a name nothing defines refused" {
  let refused = Ok(@hcl.parse("a = var.nope\n", context=@hcl.standard())) catch {
    error => Err(error)
  }
  match refused {
    Err(_) => ()
    Ok(_) => fail("this document should be refused")
  }
}

///|
test "hashicorp hcl: a function nothing defines refused" {
  let refused = Ok(@hcl.parse("a = nope(1)\n", context=@hcl.standard())) catch {
    error => Err(error)
  }
  match refused {
    Err(_) => ()
    Ok(_) => fail("this document should be refused")
  }
}

