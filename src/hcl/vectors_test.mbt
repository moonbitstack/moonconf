test "hashicorp hcl: unary" {
  let body = @hcl.parse("a = -3\nb = !true\n", context=@hcl.standard())
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_int("a"), -3L)
  assert_eq(tree.need_bool("b"), false)
