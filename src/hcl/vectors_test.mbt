test "hashicorp hcl: names and indexing" {
  let body = @hcl.parse(
    "a = var.region\nb = var.tags[\"env\"]\n",
    context=@hcl.standard().bind(
      "var",
      @moonconf.Node::map(
        [
          ("region", @moonconf.Node::str("eu-west-1", "vars")),
          (
            "tags",
            @moonconf.Node::map(
              [("env", @moonconf.Node::str("prod", "vars"))],
              "vars",
            ),
          ),
        ],
        "vars",
      ),
    ),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_text("a"), "eu-west-1")
  assert_eq(tree.need_text("b"), "prod")
}

///|
test "hashicorp hcl: a list from the context" {
  let body = @hcl.parse(
    "a = var.hosts[1]\nb = length(var.hosts)\n",
    context=@hcl.standard().bind(
      "var",
      @moonconf.Node::map(
        [
          (
            "hosts",
            @moonconf.Node::seq(
              [
                @moonconf.Node::str("one", "vars"),
                @moonconf.Node::str("two", "vars"),
              ],
              "vars",
            ),
          ),
        ],
        "vars",
      ),
    ),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_text("a"), "two")
  assert_eq(tree.need_int("b"), 2L)
}

///|
test "hashicorp hcl: block with a label" {
  let body = @hcl.parse(
    "server \"web\" {\n  port = 80\n}\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_int("server.port"), 80L)
  assert_eq(body.blocks_of("server").map(fn(b) { b.labels.join("/") }), ["web"])
}

///|
test "hashicorp hcl: block with two labels" {
  let body = @hcl.parse(
    "resource \"aws_instance\" \"web\" {\n  ami = \"abc\"\n}\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_text("resource.ami"), "abc")
  assert_eq(body.blocks_of("resource").map(fn(b) { b.labels.join("/") }), [
    "aws_instance/web",
  ])
}

///|
test "hashicorp hcl: nested blocks" {
  let body = @hcl.parse(
    "outer {\n  inner {\n    a = 1\n  }\n}\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_int("outer.inner.a"), 1L)
  assert_eq(body.blocks_of("outer").map(fn(b) { b.labels.join("/") }), [""])
}

///|
test "hashicorp hcl: repeated blocks" {
  let body = @hcl.parse(
    "server \"a\" {\n  port = 1\n}\nserver \"b\" {\n  port = 2\n}\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need("server").list().length(), 2)
  assert_eq(tree.need_int("server.0.port"), 1L)
  assert_eq(tree.need_int("server.1.port"), 2L)
  assert_eq(body.blocks_of("server").map(fn(b) { b.labels.join("/") }), [
    "a", "b",
  ])
}

///|
test "hashicorp hcl: attribute and block side by side" {
  let body = @hcl.parse(
    "name = \"web\"\nserver \"a\" {\n  port = 1\n}\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_text("name"), "web")
  assert_eq(tree.need_int("server.port"), 1L)
  assert_eq(body.blocks_of("server").map(fn(b) { b.labels.join("/") }), ["a"])
}

///|
test "hashicorp hcl: empty block" {
  let body = @hcl.parse("server \"a\" {\n}\n", context=@hcl.standard())
  let tree = body.tree("main.hcl")
  assert_eq(tree.need("server").table().length(), 0)
  assert_eq(body.blocks_of("server").map(fn(b) { b.labels.join("/") }), ["a"])
}

///|
test "hashicorp hcl: upper and lower" {
  let body = @hcl.parse(
    "a = upper(\"web\")\nb = lower(\"WEB\")\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_text("a"), "WEB")
  assert_eq(tree.need_text("b"), "web")
}

