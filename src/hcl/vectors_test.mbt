// Generated by scripts/vectors/hcl from hashicorp/hcl v2.24.0.
// Do not edit by hand: the answers below are what that reader produced.

///|
test "hashicorp hcl: plain" {
  let body = @hcl.parse(
    "a = 1\nb = 1.5\nc = true\nd = null\ne = \"x\"\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_int("a"), 1L)
  assert_eq(tree.need("b").real(), 1.5)
  assert_eq(tree.need_bool("c"), true)
  assert_eq(tree.need("d").kind(), "null")
  assert_eq(tree.need_text("e"), "x")
}

///|
test "hashicorp hcl: negative numbers" {
  let body = @hcl.parse("a = -1\nb = -2.5\nc = 1e3\n", context=@hcl.standard())
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_int("a"), -1L)
  assert_eq(tree.need("b").real(), -2.5)
  assert_eq(tree.need_int("c"), 1000L)
}

///|
test "hashicorp hcl: list" {
  let body = @hcl.parse("a = [1, 2, 3]\n", context=@hcl.standard())
  let tree = body.tree("main.hcl")
  assert_eq(tree.need("a").list().length(), 3)
  assert_eq(tree.need_int("a.0"), 1L)
  assert_eq(tree.need_int("a.1"), 2L)
  assert_eq(tree.need_int("a.2"), 3L)
}

///|
test "hashicorp hcl: object" {
  let body = @hcl.parse("a = { x = 1, y = 2 }\n", context=@hcl.standard())
  let tree = body.tree("main.hcl")
  assert_eq(tree.need_int("a.x"), 1L)
  assert_eq(tree.need_int("a.y"), 2L)
}

///|
test "hashicorp hcl: nested collections" {
  let body = @hcl.parse(
    "a = [{ b = [1, { c = 2 }] }]\n",
    context=@hcl.standard(),
  )
  let tree = body.tree("main.hcl")
  assert_eq(tree.need("a").list().length(), 1)
  assert_eq(tree.need("a.0.b").list().length(), 2)
  assert_eq(tree.need_int("a.0.b.0"), 1L)
  assert_eq(tree.need_int("a.0.b.1.c"), 2L)
}

