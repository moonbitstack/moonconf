// HOCON: JSON with the punctuation relaxed, plus merging, references and
// includes -- the format Typesafe Config reads.
//
// A document is read into the same tree the rest of this repository uses, so a
// HOCON file, an INI file and the environment merge into one answer.
import {
  "moonbitstack/moonconf",
}

import {
  "moonbitstack/moonconf/hocon",
} for "test"
