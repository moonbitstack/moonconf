///|
test "typesafe config: array joined by whitespace is one element" {
  let doc = @hocon.parse("a = [1 2 3 4]\n")
  // whitespace concatenates, it does not separate
  assert_eq(doc.need("a").list().length(), 1)
  assert_eq(doc.need_text("a.0"), "1 2 3 4")
}

///|
test "typesafe config: nested array joined" {
  let doc = @hocon.parse("a = [[1, 2] [3, 4]]\n")
  assert_eq(doc.need("a").list().length(), 1)
  assert_eq(doc.need("a.0").list().length(), 4)
  assert_eq(doc.need_int("a.0.0"), 1L)
  assert_eq(doc.need_int("a.0.1"), 2L)
  assert_eq(doc.need_int("a.0.2"), 3L)
  assert_eq(doc.need_int("a.0.3"), 4L)
}

///|
test "typesafe config: nested arrays on separate lines" {
  let doc = @hocon.parse("a = [[1, 2]\n[3, 4]]\n")
  assert_eq(doc.need("a").list().length(), 2)
  assert_eq(doc.need("a.0").list().length(), 2)
  assert_eq(doc.need_int("a.0.0"), 1L)
  assert_eq(doc.need_int("a.0.1"), 2L)
  assert_eq(doc.need("a.1").list().length(), 2)
  assert_eq(doc.need_int("a.1.0"), 3L)
  assert_eq(doc.need_int("a.1.1"), 4L)
}

