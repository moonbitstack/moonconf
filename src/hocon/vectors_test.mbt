test "typesafe config: arrays written next to each other join" {
  let doc = @hocon.parse("a = [1, 2] [3, 4]\n")
  assert_eq(doc.need("a").list().length(), 4)
  assert_eq(doc.need_int("a.0"), 1L)
  assert_eq(doc.need_int("a.1"), 2L)
  assert_eq(doc.need_int("a.2"), 3L)
  assert_eq(doc.need_int("a.3"), 4L)
}

