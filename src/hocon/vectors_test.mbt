  assert_eq(doc.need_int("d"), 1L)
  assert_eq(doc.need_int("a.b.c"), 1L)
}

///|
test "typesafe config: reference to an object keeps its shape" {
  let doc = @hocon.parse("a = { x = 1 }\nb = ${a}\n")
  assert_eq(doc.need_int("a.x"), 1L)
  assert_eq(doc.need_int("b.x"), 1L)
}

///|
test "typesafe config: reference to an array keeps its shape" {
  let doc = @hocon.parse("a = [1]\nb = ${a}\n")
  assert_eq(doc.need("a").list().length(), 1)
  assert_eq(doc.need_int("a.0"), 1L)
  assert_eq(doc.need("b").list().length(), 1)
  assert_eq(doc.need_int("b.0"), 1L)
}

///|
test "typesafe config: forward reference" {
  let doc = @hocon.parse("b = ${a}\na = 1\n")
  assert_eq(doc.need_int("a"), 1L)
  assert_eq(doc.need_int("b"), 1L)
}

///|
test "typesafe config: reference in an array element" {
  let doc = @hocon.parse("a = 2\nb = [1, ${a}]\n")
  assert_eq(doc.need("b").list().length(), 2)
  assert_eq(doc.need_int("b.0"), 1L)
  assert_eq(doc.need_int("b.1"), 2L)
  assert_eq(doc.need_int("a"), 2L)
}

///|
test "typesafe config: reference to a later definition of itself" {
  let doc = @hocon.parse("a = 1\na = ${a} 2\nb = ${a}\n")
  assert_eq(doc.need_text("b"), "1 2")
  assert_eq(doc.need_text("a"), "1 2")
}

///|
test "typesafe config: substitution beside a quoted string" {
  let doc = @hocon.parse("a = 1\nb = ${a}\" x\"\n")
  assert_eq(doc.need_int("a"), 1L)
  assert_eq(doc.need_text("b"), "1 x")
}

///|
test "typesafe config: optional reference present" {
  let doc = @hocon.parse("a = 1\nb = ${?a}\n")
  assert_eq(doc.need_int("a"), 1L)
  assert_eq(doc.need_int("b"), 1L)
}

///|
test "typesafe config: optional reference missing" {
  let doc = @hocon.parse("a = 1\nb = ${?nope}\n")
  assert_eq(doc.need_int("a"), 1L)
}

///|
test "typesafe config: optional reference overrides nothing" {
  let doc = @hocon.parse("b = 1\nb = ${?nope}\n")
  assert_eq(doc.need_int("b"), 1L)
}

///|
test "typesafe config: optional reference in an array" {
  let doc = @hocon.parse("a = [1, ${?nope}, 2]\n")
  assert_eq(doc.need("a").list().length(), 2)
  assert_eq(doc.need_int("a.0"), 1L)
  assert_eq(doc.need_int("a.1"), 2L)
}

///|
test "typesafe config: two optional references both missing" {
  let doc = @hocon.parse("a = ${?x}${?y}\n")
  assert_eq(doc.table().length(), 0)
}

///|
test "typesafe config: optional reference beside text" {
  let doc = @hocon.parse("a = ${?nope}x\n")
  assert_eq(doc.need_text("a"), "x")
}

///|
test "typesafe config: reference to null is not a definition" {
  let doc = @hocon.parse("a = null\nb = ${?a}\n")
  assert_eq(doc.need("a").kind(), "null")
  assert_eq(doc.need("b").kind(), "null")
}

///|
test "typesafe config: append" {
  let doc = @hocon.parse("a = [1]\na += 2\n")
  assert_eq(doc.need("a").list().length(), 2)
  assert_eq(doc.need_int("a.0"), 1L)
  assert_eq(doc.need_int("a.1"), 2L)
}

///|
test "typesafe config: append to nothing" {
  let doc = @hocon.parse("a += 1\n")
  assert_eq(doc.need("a").list().length(), 1)
  assert_eq(doc.need_int("a.0"), 1L)
}

///|
test "typesafe config: append an array" {
  let doc = @hocon.parse("a = [1]\na += [2, 3]\n")
  assert_eq(doc.need("a").list().length(), 2)
  assert_eq(doc.need_int("a.0"), 1L)
  assert_eq(doc.need("a.1").list().length(), 2)
  assert_eq(doc.need_int("a.1.0"), 2L)
  assert_eq(doc.need_int("a.1.1"), 3L)
}

///|
test "typesafe config: include" {
  let doc = @hocon.parse(
    "include \"base.conf\"\nname = app\n",
    knobs=@hocon.Knobs::with_read(fn(name) {
      if name == "base.conf" {
        Some("host = h\nport = 1\n")
      } else {
        None
      }
    }),
  )
  assert_eq(doc.need_text("host"), "h")
  assert_eq(doc.need_int("port"), 1L)
  assert_eq(doc.need_text("name"), "app")
}

///|
test "typesafe config: include then override" {
  let doc = @hocon.parse(
    "include \"base.conf\"\nport = 2\n",
    knobs=@hocon.Knobs::with_read(fn(name) {
      if name == "base.conf" {
        Some("host = h\nport = 1\n")
      } else {
        None
      }
    }),
  )
  assert_eq(doc.need_text("host"), "h")
  assert_eq(doc.need_int("port"), 2L)
}

///|
test "typesafe config: include inside an object" {
  let doc = @hocon.parse(
    "db { include \"db.conf\" }\ndb.port = 2\n",
    knobs=@hocon.Knobs::with_read(fn(name) {
      if name == "db.conf" {
        Some("host = h\nport = 1\n")
      } else {
        None
      }
    }),
  )
  assert_eq(doc.need_text("db.host"), "h")
  assert_eq(doc.need_int("db.port"), 2L)
}

///|
test "typesafe config: two includes merge" {
  let doc = @hocon.parse(
    "include \"one.conf\"\ninclude \"two.conf\"\n",
    knobs=@hocon.Knobs::with_read(fn(name) {
      if name == "one.conf" {
        Some("a = 1\nb = 1\n")
      } else if name == "two.conf" {
        Some("b = 2\n")
      } else {
        None
      }
    }),
  )
  assert_eq(doc.need_int("a"), 1L)
  assert_eq(doc.need_int("b"), 2L)
}

///|
test "typesafe config: include with a reference to the includer" {
  let doc = @hocon.parse(
    "include \"base.conf\"\nurl = ${host}-${port}\n",
    knobs=@hocon.Knobs::with_read(fn(name) {
      if name == "base.conf" {
        Some("host = h\nport = 1\n")
      } else {
        None
      }
    }),
  )
  assert_eq(doc.need_text("host"), "h")
  assert_eq(doc.need_text("url"), "h-1")
  assert_eq(doc.need_int("port"), 1L)
}

///|
test "typesafe config: unclosed object refused" {
  let refused = Ok(@hocon.parse("a {\n b = 1\n")) catch { error => Err(error) }
  match refused {
    Err(_) => ()
    Ok(_) => fail("this document should be refused")
  }
}

