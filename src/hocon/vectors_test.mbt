}

///|
test "typesafe config: duplicate arrays keep the later" {
  let doc = @hocon.parse("a = [1]\na = [2, 3]\n")
  assert_eq(doc.need("a").list().length(), 2)
  assert_eq(doc.need_int("a.0"), 2L)
