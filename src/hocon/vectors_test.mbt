///|
test "typesafe config: plain" {
  let doc = @hocon.parse("a = 1\nb = 1.5\nc = true\nd = \"x\"\n")
  assert_eq(doc.need_int("a"), 1L)
  assert_eq(doc.need("b").real(), 1.5)
  assert_eq(doc.need_bool("c"), true)
  assert_eq(doc.need_text("d"), "x")
}

///|
test "typesafe config: commas and colons" {
  let doc = @hocon.parse("a : 1, b : 2,\nc { d = 3, e = 4 }\n")
  assert_eq(doc.need_int("a"), 1L)
  assert_eq(doc.need_int("b"), 2L)
  assert_eq(doc.need_int("c.e"), 4L)
  assert_eq(doc.need_int("c.d"), 3L)
}

///|
test "typesafe config: fields without commas" {
  let doc = @hocon.parse("a { b = 1\nc = 2 }\n")
  assert_eq(doc.need_int("a.c"), 2L)
  assert_eq(doc.need_int("a.b"), 1L)
}

///|
test "typesafe config: comments" {
  let doc = @hocon.parse("# one\n// two\na = 1 # three\nb = 2 // four\n")
  assert_eq(doc.need_int("a"), 1L)
  assert_eq(doc.need_int("b"), 2L)
}

///|
test "typesafe config: unquoted string" {
  let doc = @hocon.parse("a = one two three\n")
  assert_eq(doc.need_text("a"), "one two three")
}

///|
test "typesafe config: quoted string" {
  let doc = @hocon.parse("a = \"one\\ttwo\\nthree\"\n")
  assert_eq(doc.need_text("a"), "one\ttwo\nthree")
}

