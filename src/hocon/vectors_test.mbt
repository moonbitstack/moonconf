}

///|
test "typesafe config: objects written next to each other merge" {
  let doc = @hocon.parse("a = { b = 1 } { c = 2 }\n")
  assert_eq(doc.need_int("a.c"), 2L)
  assert_eq(doc.need_int("a.b"), 1L)
