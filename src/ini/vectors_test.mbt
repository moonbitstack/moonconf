// Generated by scripts/vectors/ini.py from Python's `configparser`.
// Do not edit by hand: the answers below are what that reader produced.

///|
test "configparser: plain" {
  let doc = @ini.parse(
    "[db]\nhost = localhost\nport = 5432\n",
    knobs=@ini.standard,
  )
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["host", "port"])
  assert_eq(doc.get("db", "host"), "localhost")
  assert_eq(doc.get("db", "port"), "5432")
}

///|
test "configparser: colon separator" {
  let doc = @ini.parse(
    "[db]\nhost: localhost\nport: 5432\n",
    knobs=@ini.standard,
  )
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["host", "port"])
  assert_eq(doc.get("db", "host"), "localhost")
  assert_eq(doc.get("db", "port"), "5432")
}

///|
test "configparser: spaces around" {
  let doc = @ini.parse("[db]\n  host   =   localhost  \n", knobs=@ini.standard)
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["host"])
  assert_eq(doc.get("db", "host"), "localhost")
}

///|
test "configparser: comment lines" {
  let doc = @ini.parse(
    "; a note\n[db]\n# another\nhost = x\n",
    knobs=@ini.standard,
  )
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["host"])
  assert_eq(doc.get("db", "host"), "x")
}

///|
test "configparser: empty value" {
  let doc = @ini.parse("[db]\nhost =\n", knobs=@ini.standard)
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["host"])
  assert_eq(doc.get("db", "host"), "")
}

///|
test "configparser: value with equals" {
  let doc = @ini.parse("[db]\nurl = postgres://a?b=c\n", knobs=@ini.standard)
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["url"])
  assert_eq(doc.get("db", "url"), "postgres://a?b=c")
}

///|
test "configparser: value with hash" {
  let doc = @ini.parse("[db]\ncolor = a#b\n", knobs=@ini.standard)
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["color"])
  assert_eq(doc.get("db", "color"), "a#b")
}

///|
test "configparser: inline comment off" {
  let doc = @ini.parse("[db]\ncolor = a # b\n", knobs=@ini.standard)
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["color"])
  assert_eq(doc.get("db", "color"), "a # b")
}

///|
test "configparser: inline comment on" {
  let doc = @ini.parse("[db]\ncolor = a # b\n", knobs={
    ..@ini.standard,
    inline_comment: "#;",
  })
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["color"])
  assert_eq(doc.get("db", "color"), "a")
}

///|
test "configparser: continuation" {
  let doc = @ini.parse(
    "[db]\nquery = one\n  two\n  three\n",
    knobs=@ini.standard,
  )
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["query"])
  assert_eq(doc.get("db", "query"), "one\ntwo\nthree")
}

///|
test "configparser: continuation keeps comment" {
  let doc = @ini.parse(
    "[db]\nq = one\n  # not a comment\n  two\n",
    knobs=@ini.standard,
  )
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["q"])
  assert_eq(doc.get("db", "q"), "one\ntwo")
}

///|
test "configparser: blank inside value" {
  let doc = @ini.parse("[db]\nq = one\n\n  two\n", knobs=@ini.standard)
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["q"])
  assert_eq(doc.get("db", "q"), "one\n\ntwo")
}

///|
test "configparser: blank ends value" {
  let refused = Ok(
    @ini.parse("[db]\nq = one\n\n  two\n", knobs={
      ..@ini.standard,
      empty_lines_in_values: false,
    }),
  ) catch {
    error => Err(error)
  }
  match refused {
    Err(_) => ()
    Ok(_) => fail("ParsingError should be refused")
  }
}

///|
test "configparser: two sections" {
  let doc = @ini.parse("[a]\nx = 1\n[b]\ny = 2\n", knobs=@ini.standard)
  assert_eq(doc.sections(), ["a", "b"])
  assert_eq(doc.options("a"), ["x"])
  assert_eq(doc.get("a", "x"), "1")
  assert_eq(doc.options("b"), ["y"])
  assert_eq(doc.get("b", "y"), "2")
}

///|
test "configparser: case folded" {
  let doc = @ini.parse("[db]\nHost = x\n", knobs=@ini.standard)
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["host"])
  assert_eq(doc.get("db", "host"), "x")
}

///|
test "configparser: case preserved" {
  let doc = @ini.parse("[db]\nHost = x\n", knobs={
    ..@ini.standard,
    case: Preserve,
  })
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["Host"])
  assert_eq(doc.get("db", "Host"), "x")
}

///|
test "configparser: bare name off" {
  let refused = Ok(@ini.parse("[db]\nflag\n", knobs=@ini.standard)) catch {
    error => Err(error)
  }
  match refused {
    Err(_) => ()
    Ok(_) => fail("ParsingError should be refused")
  }
}

///|
test "configparser: bare name on" {
  let doc = @ini.parse("[db]\nflag\n", knobs={
    ..@ini.standard,
    allow_no_value: true,
  })
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["flag"])
  assert_eq(doc.get("db", "flag"), "")
}

///|
test "configparser: defaults fall back" {
  let doc = @ini.parse(
    "[DEFAULT]\nhost = base\n[db]\nport = 1\n",
    knobs=@ini.standard,
  )
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["port", "host"])
  assert_eq(doc.get("db", "port"), "1")
  assert_eq(doc.get("db", "host"), "base")
}

///|
test "configparser: basic interpolation" {
  let doc = @ini.parse(
    "[db]\nhost = h\nurl = pg://%(host)s/db\n",
    knobs=@ini.standard,
  )
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["host", "url"])
  assert_eq(doc.get("db", "host"), "h")
  assert_eq(doc.get("db", "url"), "pg://h/db")
}

///|
test "configparser: basic percent escape" {
  let doc = @ini.parse("[db]\nrate = 100%%\n", knobs=@ini.standard)
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["rate"])
  assert_eq(doc.get("db", "rate"), "100%")
}

///|
test "configparser: extended interpolation" {
  let doc = @ini.parse("[db]\nhost = h\nurl = pg://${host}/db\n", knobs={
    ..@ini.standard,
    interp: Extended,
  })
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["host", "url"])
  assert_eq(doc.get("db", "host"), "h")
  assert_eq(doc.get("db", "url"), "pg://h/db")
}

///|
test "configparser: extended across sections" {
  let doc = @ini.parse("[a]\nhost = h\n[b]\nurl = ${a:host}/x\n", knobs={
    ..@ini.standard,
    interp: Extended,
  })
  assert_eq(doc.sections(), ["a", "b"])
  assert_eq(doc.options("a"), ["host"])
  assert_eq(doc.get("a", "host"), "h")
  assert_eq(doc.options("b"), ["url"])
  assert_eq(doc.get("b", "url"), "h/x")
}

///|
test "configparser: extended dollar escape" {
  let doc = @ini.parse("[db]\nprice = $5\n", knobs={
    ..@ini.standard,
    interp: Extended,
  })
  let refused = Ok(doc.get("db", "price")) catch { error => Err(error) }
  match refused {
    Err(_) => ()
    Ok(_) => fail("InterpolationSyntaxError should be refused")
  }
}

///|
test "configparser: duplicate option refused" {
  let refused = Ok(@ini.parse("[db]\nx = 1\nx = 2\n", knobs=@ini.standard)) catch {
    error => Err(error)
  }
  match refused {
    Err(_) => ()
    Ok(_) => fail("DuplicateOptionError should be refused")
  }
}

///|
test "configparser: duplicate option allowed" {
  let doc = @ini.parse("[db]\nx = 1\nx = 2\n", knobs={
    ..@ini.standard,
    strict: false,
  })
  assert_eq(doc.sections(), ["db"])
  assert_eq(doc.options("db"), ["x"])
  assert_eq(doc.get("db", "x"), "2")
}

///|
test "configparser: option before section refused" {
  let refused = Ok(@ini.parse("x = 1\n", knobs=@ini.standard)) catch {
    error => Err(error)
  }
  match refused {
    Err(_) => ()
    Ok(_) => fail("MissingSectionHeaderError should be refused")
  }
}

///|
test "configparser: unclosed section refused" {
  let refused = Ok(@ini.parse("[db\nx = 1\n", knobs=@ini.standard)) catch {
    error => Err(error)
  }
  match refused {
    Err(_) => ()
    Ok(_) => fail("MissingSectionHeaderError should be refused")
  }
}

///|
test "configparser: missing option refused" {
  let doc = @ini.parse("[db]\nx = 1\ny = %(nope)s\n", knobs=@ini.standard)
  let refused = Ok(doc.get("db", "y")) catch { error => Err(error) }
  match refused {
    Err(_) => ()
    Ok(_) => fail("InterpolationMissingOptionError should be refused")
  }
}
