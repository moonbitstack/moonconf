  let doc = @props.parse("a b\n")
  assert_eq(doc.get("a"), Some("b"))
}

///|
test "java: spaces around" {
  let doc = @props.parse("  a  =  b  \n")
  assert_eq(doc.get("a"), Some("b  "))
}

