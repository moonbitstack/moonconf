  let doc = @props.parse("# a note\na=1\n")
  assert_eq(doc.get("a"), Some("1"))
}

///|
test "java: bang comment" {
  let doc = @props.parse("! another\na=1\n")
  assert_eq(doc.get("a"), Some("1"))
